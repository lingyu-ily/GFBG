# Local development: http://localhost:5173; production: your HTTPS origin, no subpath.
PUBLIC_URL=https://games.example.com
# Existing PostgreSQL, dedicated database and role. URL-encode password characters.
DATABASE_URL=postgresql://tablefolk:CHANGE_ME@192.168.1.10:5432/tablefolk
PORT=3000
HOST_PORT=3000
# Leave false for normal startup. Run npm run migrate / migration container explicitly.
AUTO_MIGRATE=false
# Number of trusted reverse proxy hops. Restrict host port access to those proxies.
TRUST_PROXY_HOPS=1
# 587 uses mandatory STARTTLS; 465 uses implicit TLS.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=games@example.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM="古楓桌遊 GFBG <games@example.com>"
# Optional member avatars in a pre-created public RustFS bucket. Set all or none.
# S3 API endpoint can be internal HTTP; the public base URL must be HTTPS in production.
AVATAR_S3_ENDPOINT=http://rustfs:9000
AVATAR_S3_REGION=us-east-1
AVATAR_S3_BUCKET=gfbg-avatars
AVATAR_S3_ACCESS_KEY_ID=CHANGE_ME
AVATAR_S3_SECRET_ACCESS_KEY=CHANGE_ME
AVATAR_PUBLIC_BASE_URL=https://assets.example.com/gfbg-avatars
TZ=Asia/Taipei
